# ============================================================
# PROJECT: Parking Revenue Analytics
# FILE: .gitignore
#
# PURPOSE:
# Protect confidential data and exclude local files that
# should not be uploaded to GitHub.
#
# IMPORTANT:
# - Commit Python scripts, SQL scripts, and documentation.
# - Never commit actual parking transaction data.
# - Only publish synthetic data in data/sample/.
# - Do not commit passwords, credentials, or local databases.
# - Changes to .gitignore do not untrack previously
#   committed files.
# ============================================================


# ------------------------------------------------------------
# 1. CONFIDENTIAL PARKING TRANSACTION DATA
# ------------------------------------------------------------

# Ignore all files within incoming, but preserve the folder
/data/incoming/**
!/data/incoming/.gitkeep

# Ignore Excel and CSV files throughout the project
*.xlsx
*.xls
*.xlsm
*.csv

# Exception: allow synthetic sample data for GitHub
!/data/sample/*.xlsx
!/data/sample/*.csv


# ------------------------------------------------------------
# 2. PYTHON VIRTUAL ENVIRONMENT
# ------------------------------------------------------------

# Each computer creates its own virtual environment
.venv/
venv/
env/


# ------------------------------------------------------------
# 3. PYTHON GENERATED FILES
# ------------------------------------------------------------

__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/


# ------------------------------------------------------------
# 4. PASSWORDS AND LOCAL CONFIGURATION
# ------------------------------------------------------------

# Never upload local environment files or credentials
.env
.env.*
!.env.example

# Common files containing local secrets
secrets.json
credentials.json


# ------------------------------------------------------------
# 5. SQL SERVER LOCAL DATABASE FILES
# ------------------------------------------------------------

# Database files and backups are stored separately
*.mdf
*.ndf
*.ldf
*.bak


# ------------------------------------------------------------
# 6. POWER BI TEMPORARY FILES
# ------------------------------------------------------------

# Exclude Power BI local cache and user-specific settings
*.pbi/
*.pbix.autorecover
*.tmp

# Keep actual .pbix and .pbip project files
# Review them for embedded data before committing.


# ------------------------------------------------------------
# 7. LOGS AND TEMPORARY FILES
# ------------------------------------------------------------

*.log
*.temp
*.bak~
~$*
Thumbs.db
.DS_Store


# ------------------------------------------------------------
# 8. VS CODE LOCAL SETTINGS
# ------------------------------------------------------------

# Ignore user-specific editor settings
.vscode/settings.json
.vscode/launch.json

# Keep shared project configuration if created later
# such as .vscode/extensions.json


# ------------------------------------------------------------
# 9. FILES THAT SHOULD REMAIN TRACKED
# ------------------------------------------------------------

# Python scripts:
# python/*.py
#
# SQL scripts:
# sql/*.sql
#
# Documentation:
# README.md
# docs/
#
# Dependency list:
# requirements.txt
#
# Power BI project:
# powerbi/
#
# Synthetic sample data:
# data/sample/
# ============================================================